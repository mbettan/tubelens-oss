# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini Models (paid Vertex AI API key recommended)
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# YouTube Data API Key (get from https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=your-youtube-data-api-key

# MCP Server Authentication
AUTH_MODE=none  # Options: iam, api_key, none
MCP_API_KEY=    # Required when AUTH_MODE=api_key

# OAuth 2.0 Settings (RFC 6749, RFC 7591, RFC 8414)
OAUTH_ADMIN_PASSWORD=  # When set, /oauth/authorize consent page requires this password
OAUTH_REGISTRATION_TOKEN=  # When set, /oauth/register requires Bearer <token> auth
OAUTH_JWT_SECRET=  # Optional custom HMAC key (auto-generated if omitted)

# Server Settings
PORT=8080
HOST=0.0.0.0
